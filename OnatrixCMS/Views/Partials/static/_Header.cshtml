@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Routing
@using Umbraco.Extensions
@using static Umbraco.Cms.Core.PropertyEditors.ValueConverters.ColorPickerValueConverter;
@inject IPublishedValueFallback PublishedValueFallback
@inject IPublishedUrlProvider PublishedUrlProvider

@{
    // Hämta "Top Header" innehållsnoden
    var header = Umbraco.ContentAtRoot().FirstOrDefault(x => x.ContentType.Alias == "header");
    // Hämta adressen
    var logotype = header?.Value<IPublishedContent>("logotype")?.Url() ?? null;

    var backgroundColor = header?.Value<PickedColor>("backgroundColor")?.Label.ToLower() ?? "transparent";
    var textColor = "var(--color-lightgray)";

    var topHeader = false;
    var btnBar = false;
    var menuClass = "header__mobilmenu header__mobilmenu-hidden";

}

<!-- Header -->
<div class="header__wrapper">

    @if(topHeader)
    {
        @await Html.PartialAsync("/Views/Partials/static/_TopHeader.cshtml")
    }
    else
    {
        <div></div>
    }

    <div class="header" style="background-color: var(--color-@backgroundColor);">

        <a class="header__homelink" href="/">
            <div class="header__logotype-container">

                @if (!string.IsNullOrEmpty(logotype))
                {
                    <img class="header__logotype" src="@logotype" alt="Logotyp" />
                }
                else
                {
                    <div>HOME</div>
                }
            </div>
        </a>


        <nav class="header__nav-desktop">
            @await Html.PartialAsync("/Views/Partials/_Navigation.cshtml")
        </nav>

        @if(btnBar)
        {
            @await Html.PartialAsync("/Views/Partials/static/_BtnBar.cshtml")
        }
        else
        {
            <div></div>
        }


        <div id="menuToggleBtn" class="header__mobilmenu-icon" style="color: var(--color-@textColor);">
            <i id="menuToggleIcon" class="fa-solid fa-bars"></i>
        </div>

        <div id="mobileMenu" class="@menuClass">
            @Html.Partial("/Views/Partials/static/_HeaderSideMenu.cshtml")
        </div>

    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggleBtn = document.getElementById('menuToggleBtn');
        const toggleIcon = document.getElementById('menuToggleIcon');
        const menu = document.getElementById('mobileMenu');
        let isMenuOpen = false;

        toggleBtn.addEventListener('click', function () {
            if (isMenuOpen) {
                menu.classList.remove('header__mobilmenu--visble');
                menu.classList.add('header__mobilmenu-hidden');
                toggleIcon.classList.remove('fa-xmark');
                toggleIcon.classList.add('fa-bars');
                toggleBtn.classList.remove('header__mobilmenu-icon--rotate', 'header__mobilmenu-icon--fade-in');
                isMenuOpen = false;
            } else {
                menu.classList.remove('header__mobilmenu-hidden');
                menu.classList.add('header__mobilmenu--visble');
                toggleIcon.classList.remove('fa-bars');
                toggleIcon.classList.add('fa-xmark');
                toggleBtn.classList.add('header__mobilmenu-icon--rotate', 'header__mobilmenu-icon--fade-in');
                isMenuOpen = true;
            }
        });
    });
</script>
