@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var posts = Model.Children().Where(x => x.ContentType.Alias == "blogPost").OrderByDescending(x => x.CreateDate);
}

<h1>@Model.Value("title")</h1>
<p>@Model.Value("description")</p>

@foreach (var post in posts)
{
    <div class="blog">
        <h2><a href="@post.Url()">@post.Value("rubrik")</a></h2>
        <p>@post.CreateDate.ToString("yyyy-MM-dd")</p>
        <p>@post.Value("innehåll")</p>
    </div>
}
